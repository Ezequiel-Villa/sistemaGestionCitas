# .gitignore para proyecto Python - MiniSistemaCitasMedicas
# Evitar subir entornos virtuales, archivos temporales, credenciales y artefactos de build

# Entornos virtuales
venv/
.venv/
env/
ENV/
venv_citas/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Pyre, mypy
.mypy_cache/

# PyInstaller
#  Usually these files are written by a python script from a template
*.manifest
*.spec

# Encrypted/secret files and envs
.env
.env.*
*.key
*.pem
*.crt

# Database files
*.db
*.sqlite3
db.sqlite3

# Jupyter Notebook
.ipynb_checkpoints

# VS Code / JetBrains
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs and temp
*.log
*.tmp
*~
*.bak

# Coverage and reports
coverage/
reports/

# Node (in case there are frontend parts)
node_modules/

# Tests artifacts
tests/__pycache__/

# Other
*.pyc
*.pyo
*.pyd
